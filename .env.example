# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored — never commit real secrets.

# Server-only. Never import from client components.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: override the model (default "gemini-3.6-flash")
# GEMINI_MODEL=gemini-3.6-flash

# --- Supabase ---
# Project URL and publishable (anon) key from
# Supabase Dashboard -> Project Settings -> API.
# URL example: https://abcdefg.supabase.co
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
# Publishable/anon key (NOT the service_role key — never expose that).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

